# Salin file ini menjadi .env.local (tidak ikut ke repo), lalu isi nilainya.
# Nilai diambil dari dasbor Supabase project apotikku: Project Settings → API.
# Hanya alamat dan KUNCI PUBLIK (publishable key). Kunci rahasia (service role /
# secret key) tidak pernah dipakai di aplikasi ini.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Khusus tes otomatis (npm test): project apotikku-uji.
SUPABASE_UJI_URL=https://yyyy.supabase.co
SUPABASE_UJI_PUBLISHABLE_KEY=sb_publishable_yyyy
